WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_APP_SECRET=
ADMIN_COMPANY_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Defaults to v23.0.
WHATSAPP_GRAPH_API_VERSION=
# Optional. Base URL used to build public catalog links (e.g. {{catalog_url}}
# in automated messages). Defaults to the production deployment URL.
PUBLIC_BASE_URL=
# Optional. Enables the GPT intent-classifier fallback (Fase 5) used only
# when the deterministic rules (code/sport/FAQ) don't resolve a message.
# Leave empty to keep the automation fully deterministic (zero OpenAI calls).
# Server-side only — never exposed to the browser, never logged, never stored.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5-nano.
OPENAI_CLASSIFIER_MODEL=
# Optional. Minimum confidence (0-1) required to accept a GPT classification;
# below this, the result is treated as unknown. Defaults to 0.80.
AI_CLASSIFIER_MIN_CONFIDENCE=
# Optional. GPT classifier request timeout in milliseconds. Defaults to 8000
# (gpt-5-nano with reasoning_effort "low" typically responds in 1.2-3.4s, but
# multi-clause messages combined with an already-found intent occasionally
# reached 5.9s in testing; 8000 leaves comfortable margin).
AI_CLASSIFIER_TIMEOUT_MS=
